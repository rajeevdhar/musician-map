# ── Supabase (get from supabase.com → your project → Settings → API) ──────────
# Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / public key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Admin ─────────────────────────────────────────────────────────────────────
# Your email — this Supabase account gets the admin panel
VITE_ADMIN_EMAIL=you@example.com

# ── Server only (never sent to browser) ──────────────────────────────────────
# Same project URL as above
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key (secret! — from Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Must match VITE_ADMIN_EMAIL above
ADMIN_EMAIL=you@example.com
