# ── Supabase (get from supabase.com → your project → Settings → API) ──────────
# Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / public key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google sign-in ────────────────────────────────────────────────────────────
# OAuth client ID (Google Cloud → Google Auth Platform → Clients). Public, not a secret.
# Leave blank to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Admin ─────────────────────────────────────────────────────────────────────
# Your email — this Supabase account gets the admin panel
VITE_ADMIN_EMAIL=you@example.com

# ── Server only (never sent to browser) ──────────────────────────────────────
# Same project URL as above
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key (secret! — from Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Must match VITE_ADMIN_EMAIL above
ADMIN_EMAIL=you@example.com

# ── Content moderation ────────────────────────────────────────────────────────
# OpenAI API key — used only for the free Moderation API (text screening).
# Get one at: https://platform.openai.com/api-keys
# Moderation calls are FREE (no per-call charge). Leave blank to skip text moderation.
OPENAI_API_KEY=sk-...

# ── Email notifications ───────────────────────────────────────────────────────
# Emails people about new messages, contact requests and accepted requests.
# Leave any of these blank to send no notification emails.
# Resend API key (resend.com → API Keys). Free tier: 3,000 emails/month.
RESEND_API_KEY=re_...
# Sender address on a domain verified in Resend (resend.com → Domains)
NOTIFY_FROM_EMAIL=MusicianMapper <notifications@musicianmapper.com>
# Long random string. Supabase webhooks send it in the x-webhook-secret header,
# and it signs unsubscribe links. Generate with: openssl rand -hex 32
NOTIFY_SECRET=
# Optional: base URL used in email links (default https://musicianmapper.com)
# APP_URL=http://localhost:5173
# Optional: wait before emailing, in ms, so people chatting live aren't emailed (default 120000)
# NOTIFY_DELAY_MS=120000
